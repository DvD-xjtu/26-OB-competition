# 实验续航 / Research Relay — configuration example
# Copy to .env and adjust. Never commit real tokens.

# Real PowerContext HTTP API base URL.
POWERCONTEXT_URL=http://127.0.0.1:8000

# Optional Bearer token. Leave empty when the local PowerContext server
# runs with authentication disabled. The token is only read by the Node
# server and is never sent to the browser.
POWERCONTEXT_TOKEN=

# PowerContext request timeout in milliseconds.
POWERCONTEXT_TIMEOUT_MS=8000

# Local web application bind address.
HOST=127.0.0.1
PORT=4173
